{{define "total_context"}}
<label>
  total acumulado
  <input id="total_acumulado" name="total_acumulado" type="text" readonly
         value="{{brl .Total}}"
         data-excluding-id="{{.ExcludingId}}"
         hx-get="/expenses/total-context?excluding_id={{.ExcludingId}}"
         hx-trigger="focusout from:#expense-form input delay:300ms, focusout from:#expense-form textarea delay:300ms"
         hx-target="this"
         hx-swap="outerHTML">
</label>
{{end}}
